    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idade" type="Real" array="False" size=""/>
            <output expression="&quot;Verifica&#231;&#227;o de idade para entrada gratuita&quot;" newline="True"/>
            <output expression="&quot;Qual a sua idade?&quot;" newline="True"/>
            <input variable="idade"/>
            <if expression="idade &lt;= 5 or idade &gt;= 65">
                <then>
                    <output expression="&quot;Entrada gratuita&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Tem que pagar o ingresso&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
