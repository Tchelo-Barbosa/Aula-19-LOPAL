    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor" type="Real" array="False" size=""/>
            <declare name="vip, cupom, parcela" type="String" array="False" size=""/>
            <output expression="&quot;Veja se voc&#234; poder&#225; ter direito ao SUPER DESCONTO&quot;" newline="True"/>
            <output expression="&quot;Digite o valor da compra: &quot;" newline="False"/>
            <input variable="valor"/>
            <output expression="&quot;Voc&#234; &#233; cliente VIP?&quot;" newline="True"/>
            <input variable="vip"/>
            <output expression="&quot;Voc&#234; possui cupom?&quot;" newline="True"/>
            <input variable="cupom"/>
            <output expression="&quot;Voc&#234; tem parcelas atrasadas?&quot;" newline="True"/>
            <input variable="parcela"/>
            <if expression="(((vip = &quot;sim&quot;) and (valor &gt;=500)) or ((cupom = &quot;sim&quot;) and not (parcela = &quot;sim&quot;)))">
                <then>
                    <output expression="&quot;Voc&#234; garantiu o SUUUPER DESCONTO!!!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Desconto NE-GA-DO!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
