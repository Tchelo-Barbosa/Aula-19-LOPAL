    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nota, frequencia" type="Real" array="False" size=""/>
            <output expression="&quot;Vamos ver a sua nota!&quot;" newline="True"/>
            <output expression="&quot;Digite a nota do aluno&quot;" newline="True"/>
            <input variable="nota"/>
            <output expression="&quot;Agora coloque a frequencia dele&quot;" newline="True"/>
            <input variable="frequencia"/>
            <if expression="nota &gt;= 7 and frequencia &gt;= 75">
                <then>
                    <output expression="&quot;Aprovado&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Reprovado&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
